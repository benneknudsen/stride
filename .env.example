# Database
DATABASE_URL=

# Auth (NextAuth v5)
AUTH_SECRET=
# Canonical origin of the deployment, e.g. https://stride-run.club (origin only, no
# trailing path). Vercel sets this automatically; set it explicitly when
# self-hosting so Auth.js builds callback URLs from it rather than the request's
# Host header (issue #143). `trustHost: true` (auth.config.ts) handles host
# trust; this pins the URL so a spoofed Host cannot rewrite links.
AUTH_URL=

# Strava OAuth (kræver Strava-abonnement)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=
STRAVA_VERIFY_TOKEN=

# Encryption (32-byte hex key for AES-256-GCM)
ENCRYPTION_KEY=

# Rate limiting — Upstash Redis REST credentials. lib/rate-limit.ts reads BOTH and
# treats them as one unit; a half-set pair is a misconfiguration, not an opt-out
# (issue #294). Vercel does not set these for you — set both in Production and
# Preview, or the limiter degrades to a process-local Map: fine locally, but on
# Vercel every instance keeps its own counters, so the real limit is N× the
# configured one and resets on each cold start.
# The deployment also carries provisioned-but-unread REDIS_URL, KV_URL and
# KV_REST_API_* vars (Vercel Marketplace). No code here reads them; do not assume
# they wire up rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Error observability — Sentry (issue #178).
# Unset = Sentry.init is a no-op and captureError just logs to console; the app
# runs fine without it. SENTRY_DSN is server/edge-side; the browser needs the
# NEXT_PUBLIC_ copy (same DSN value) since server-only vars aren't exposed to it.
# SENTRY_ORG/PROJECT/AUTH_TOKEN are build-time only, for source-map upload.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
